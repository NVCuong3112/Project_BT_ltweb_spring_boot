<?xml version="1.0" encoding="UTF-8"?>
<sitemesh>
    <!-- Xóa decorator-prefix mặc định để không bị tự động chèn thêm "/WEB-INF/decorators/" -->
    <decorator-prefix></decorator-prefix>

    <!-- Decorator mặc định cho tất cả các trang web trong hệ thống -->
    <mapping path="/*" decorator="/decorators/decorator.jsp"/>

    <!-- Loại trừ các file tĩnh, hình ảnh và thư mục decorator nội bộ -->
    <mapping path="/uploads/*" exclude="true"/>
    <mapping path="/css/*" exclude="true"/>
    <mapping path="/js/*" exclude="true"/>
    <mapping path="/images/*" exclude="true"/>
    <mapping path="/decorators/*" exclude="true"/>
    <mapping path="/WEB-INF/decorators/*" exclude="true"/>
</sitemesh>

