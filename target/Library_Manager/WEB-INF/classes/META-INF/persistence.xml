<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <!-- Đơn vị quản trị thực thể JPA (Persistence Unit) -->
    <persistence-unit name="libraryPU" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <!-- Khai báo các Entity được quản lý (Category trước Product để tạo đúng khóa ngoại) -->
        <class>com.example.webapp.model.Category</class>
        <class>com.example.webapp.model.Product</class>
        <class>com.example.webapp.model.User</class>
        <class>com.example.webapp.model.OtpCode</class>

        <properties>
            <!-- Thông tin kết nối SQL Server (lấy từ cấu hình DBConnection cũ) -->
            <property name="jakarta.persistence.jdbc.driver" value="com.microsoft.sqlserver.jdbc.SQLServerDriver"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:sqlserver://localhost:60871;databaseName=servlet_demo;encrypt=true;trustServerCertificate=true;"/>
            <property name="jakarta.persistence.jdbc.user" value="sa"/>
            <property name="jakarta.persistence.jdbc.password" value="123456"/>

            <!-- Tự động cập nhật bảng trong DB theo Entity (update) -->
            <property name="hibernate.hbm2ddl.auto" value="update"/>

            <!-- Hiển thị câu lệnh SQL trong Console để theo dõi và báo cáo -->
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
            <property name="hibernate.highlight_sql" value="true"/>
        </properties>
    </persistence-unit>
</persistence>
